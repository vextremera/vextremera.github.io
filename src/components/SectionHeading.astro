---
interface Props {
	n: string;
	title: string;
	lead?: string;
	/** El h2 de la sección. Las páginas de caso lo bajan a h3. */
	as?: 'h2' | 'h3';
}

const { n, title, lead, as: Tag = 'h2' } = Astro.props;
---

<div class="grid grid-cols-12 items-baseline gap-x-6 gap-y-5 border-t border-line pt-6">
	<div class="col-span-12 flex items-baseline gap-4 lg:col-span-5" data-reveal>
		<span class="label text-accent tabular-nums" data-head-n aria-hidden="true">{n}</span>
		<Tag class="text-h2 font-semibold" data-head-title>{title}</Tag>
	</div>

	{
		lead && (
			<p class="col-span-12 max-w-[46ch] text-lead text-muted text-pretty lg:col-span-6 lg:col-start-7" data-reveal>
				{lead}
			</p>
		)
	}
</div>

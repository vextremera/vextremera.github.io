---
import { getDict } from '../i18n/utils';
import type { Locale } from '../i18n/types';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = getDict(locale);
const year = new Date().getFullYear();
---

<footer class="shell border-t border-line py-10">
	<div class="grid grid-cols-12 gap-x-6 gap-y-8">
		{/* Colofón: de qué está hecha esta página. Un detalle de imprenta
		    que además responde a la primera pregunta de cualquier técnico. */}
		<p class="col-span-12 max-w-[64ch] text-xs leading-relaxed text-faint text-pretty lg:col-span-6">
			{t.footer.colophon}
		</p>

		<div
			class="col-span-12 flex flex-wrap items-baseline justify-between gap-4 lg:col-span-5 lg:col-start-8 lg:justify-end lg:gap-10"
		>
			<p class="label text-faint">
				© {year} · {t.footer.rights}
			</p>

			<a href="#main" class="label link-underline text-muted hover:text-ink">
				{t.footer.toTop} ↑
			</a>
		</div>
	</div>
</footer>

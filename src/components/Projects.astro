---
import SectionHeading from './SectionHeading.astro';
import ProjectCover from './ProjectCover.astro';
import { getDict, projectPath } from '../i18n/utils';
import type { Locale } from '../i18n/types';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = getDict(locale).projects;

const featured = t.items.find((p) => p.featured) ?? t.items[0];
const rest = t.items.filter((p) => p !== featured);
---

<section id="projects" class="shell py-24 md:py-32">
	<SectionHeading n={t.n} title={t.title} lead={t.lead} />

	{/* ------------------------------------------------------------------
	    Caso principal: composición asimétrica, la portada manda.
	    ------------------------------------------------------------------ */}
	<article class="group relative mt-14 grid grid-cols-12 gap-x-6 gap-y-8 md:mt-20" data-reveal>
		<div class="col-span-12 lg:col-span-7">
			{/* Sin enlace propio: el título usa el patrón de enlace extendido
			    y cubre toda la tarjeta. Un solo destino por proyecto. */}
			<ProjectCover
				n={featured.n}
				name={featured.name}
				cover={featured.cover}
				ratio="aspect-4/3 lg:aspect-16/11"
				framed
			/>
		</div>

		<div class="col-span-12 flex flex-col lg:col-span-4 lg:col-start-9">
			<div class="flex items-center gap-3">
				<span class="label text-accent">{t.featuredLabel}</span>
				{
					featured.placeholder && (
						<span class="label border border-dashed border-line px-2 py-1 text-faint">
							{t.placeholderBadge}
						</span>
					)
				}
			</div>

			<h3 class="mt-5 text-h3 font-semibold text-balance">
				<a
					href={projectPath(locale, featured.slug)}
					class="after:absolute after:inset-0 after:content-['']"
				>
					{featured.name}
				</a>
			</h3>

			<p class="mt-3 text-muted text-pretty">{featured.tagline}</p>

			<dl class="mt-7 grid grid-cols-2 gap-x-6 gap-y-3">
				<div class="border-t border-line pt-2.5">
					<dt class="label text-faint">{t.labels.year}</dt>
					<dd class="mt-1.5 text-sm font-medium">{featured.year}</dd>
				</div>
				<div class="border-t border-line pt-2.5">
					<dt class="label text-faint">{t.labels.role}</dt>
					<dd class="mt-1.5 text-sm font-medium">{featured.role}</dd>
				</div>
			</dl>

			<ul class="mt-6 flex flex-wrap gap-x-2 gap-y-2">
				{
					featured.stack.map((tech) => (
						<li class="label border border-line px-2.5 py-1.5 text-muted">{tech}</li>
					))
				}
			</ul>

			<p class="mt-8 flex items-center gap-2 text-sm font-medium">
				{t.viewCase}
				<span
					class="transition-transform duration-500 ease-out-expo group-hover:translate-x-1.5"
					aria-hidden="true">→</span
				>
			</p>
		</div>
	</article>

	{/* ------------------------------------------------------------------
	    Proyectos secundarios: rejilla, menos peso, misma atención.
	    ------------------------------------------------------------------ */}
	<div class="mt-20 grid grid-cols-12 gap-x-6 gap-y-14 md:mt-28" data-reveal-group>
		{
			rest.map((project) => (
				<article
					class:list={[
						'group relative col-span-12 sm:col-span-6 lg:col-span-4',
						/* Un hueco anunciado pesa menos que un caso real, pero
						   sigue estando: se atenúa, no se esconde. */
						project.soon && 'opacity-60',
					]}
					data-reveal
				>
					<ProjectCover n={project.n} name={project.name} cover={project.cover} framed />

					<div class="mt-5 flex items-baseline justify-between gap-4">
						<h3 class="text-lg leading-tight font-semibold tracking-tight">
							{project.soon ? (
								project.name
							) : (
								<a
									href={projectPath(locale, project.slug)}
									class="after:absolute after:inset-0 after:content-['']"
								>
									{project.name}
								</a>
							)}
						</h3>
						{/* La flecha promete que hay algo al otro lado. Sin
						    destino, sobra. */}
						{!project.soon && (
							<span
								class="text-sm opacity-0 transition-all duration-500 ease-out-expo group-hover:translate-x-0.5 group-hover:opacity-100"
								aria-hidden="true"
							>
								→
							</span>
						)}
					</div>

					{project.tagline && <p class="mt-2 text-sm text-muted text-pretty">{project.tagline}</p>}

					{project.stack.length > 0 && (
						<ul class="mt-4 flex flex-wrap gap-x-3 gap-y-1">
							{project.stack.map((tech) => (
								<li class="label text-faint">{tech}</li>
							))}
						</ul>
					)}

					{project.placeholder && (
						<p class="label mt-4 inline-block border border-dashed border-line px-2 py-1 text-faint">
							{t.placeholderBadge}
						</p>
					)}
				</article>
			))
		}
	</div>
</section>

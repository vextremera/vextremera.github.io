---
import SectionHeading from './SectionHeading.astro';
import { getDict } from '../i18n/utils';
import type { Locale } from '../i18n/types';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = getDict(locale).method;
---

<section id="method" class="shell py-24 md:py-32">
	<SectionHeading n={t.n} title={t.title} lead={t.lead} />

	<ul class="mt-14 grid grid-cols-12 gap-x-6 gap-y-px md:mt-20" data-reveal-group>
		{
			t.items.map((item, i) => (
				<li
					class="group relative col-span-12 border-t border-line pt-6 pb-9 sm:col-span-6 lg:col-span-3"
					data-reveal
				>
					{/* La línea recorre el borde superior al pasar por encima, igual
					    que en experiencia y formación. */}
					<span
						class="absolute top-0 left-0 h-px w-0 bg-accent transition-[width] duration-[900ms] ease-out-expo group-hover:w-full"
						aria-hidden="true"
					/>

					{/* El numeral en trazo hueco, el mismo recurso que las portadas
					    de proyecto. Va en posición absoluta para que no empuje el
					    texto, y hueco para que no compita con él. */}
					<span
						class="pointer-events-none absolute top-4 right-0 font-display text-[3.5rem] leading-none text-transparent tabular-nums transition-all duration-[900ms] ease-out-expo [-webkit-text-stroke:1px_var(--color-line)] group-hover:-translate-y-1 group-hover:[-webkit-text-stroke:1px_var(--color-accent)]"
						aria-hidden="true"
					>
						{String(i + 1).padStart(2, '0')}
					</span>

					<span class="label text-faint transition-colors duration-500 group-hover:text-accent">
						{item.tag}
					</span>

					{/* Deja pasar el numeral antes de empezar a escribir. */}
					<h3 class="mt-14 text-lg leading-tight font-semibold tracking-tight text-balance">
						{item.title}
					</h3>

					<p class="mt-3 text-sm leading-relaxed text-muted text-pretty">{item.body}</p>
				</li>
			))
		}
	</ul>
</section>

---
import SectionHeading from './SectionHeading.astro';
import { getDict } from '../i18n/utils';
import type { Locale } from '../i18n/types';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = getDict(locale).method;
---

<section id="method" class="shell py-24 md:py-32">
	<SectionHeading n={t.n} title={t.title} lead={t.lead} />

	<ul class="mt-14 grid grid-cols-12 gap-x-6 gap-y-px md:mt-20" data-reveal-group>
		{
			t.items.map((item, i) => (
				<li
					class="group col-span-12 border-t border-line py-7 transition-colors duration-500 ease-out-expo hover:border-accent sm:col-span-6 lg:col-span-3"
					data-reveal
				>
					<div class="flex items-baseline justify-between gap-3">
						<span class="label text-faint tabular-nums" aria-hidden="true">
							{String(i + 1).padStart(2, '0')}
						</span>
						<span class="label text-right text-faint transition-colors duration-500 group-hover:text-accent">
							{item.tag}
						</span>
					</div>

					<h3 class="mt-6 text-lg leading-tight font-semibold tracking-tight text-balance">
						{item.title}
					</h3>

					<p class="mt-3 text-sm leading-relaxed text-muted text-pretty">{item.body}</p>
				</li>
			))
		}
	</ul>
</section>

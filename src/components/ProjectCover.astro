---
interface Props {
	n: string;
	name: string;
	cover?: string;
	coverAlt?: string;
	/** Clase de proporción de Tailwind. */
	ratio?: string;
	priority?: boolean;
	/**
	 * Vista de tarjeta: la captura se coloca centrada y con aire dentro de la
	 * portada tipográfica, en vez de ocupar la caja entera. Manda el número y
	 * el nombre; la imagen acompaña.
	 */
	framed?: boolean;
}

const {
	n,
	name,
	cover,
	coverAlt,
	ratio = 'aspect-4/3',
	priority = false,
	framed = false,
} = Astro.props;

/* A sangre solo cuando se pide la caja entera, que es la página de caso. */
const aSangre = Boolean(cover) && !framed;
---

<div
	class:list={[
		'relative overflow-hidden border border-line bg-raise transition-colors duration-500 ease-out-expo group-hover:border-ink',
		ratio,
	]}
>
	{
		aSangre ? (
			<img
				src={cover}
				alt={coverAlt ?? ''}
				loading={priority ? 'eager' : 'lazy'}
				decoding="async"
				fetchpriority={priority ? 'high' : 'auto'}
				class="size-full object-cover transition-transform duration-[900ms] ease-out-expo group-hover:scale-[1.025]"
			/>
		) : (
			/* Portada tipográfica: cero imágenes de stock. Manda el número y el
			   nombre, y la captura, si la hay, se posa encima con aire por los
			   cuatro lados. */
			<div class="absolute inset-0" aria-hidden="true">
				<div class="absolute inset-0 grid grid-cols-4">
					<div class="border-r border-line/60" />
					<div class="border-r border-line/60" />
					<div class="border-r border-line/60" />
					<div />
				</div>

				<span class="label absolute top-5 left-5 text-faint">{n}</span>

				<span class="absolute right-5 bottom-3 font-display text-[clamp(4rem,14vw,9rem)] leading-none text-transparent transition-all duration-[900ms] ease-out-expo [-webkit-text-stroke:1px_var(--color-line)] group-hover:-translate-y-1 group-hover:[-webkit-text-stroke:1px_var(--color-accent)]">
					{n}
				</span>

				{cover && (
					/* Recuadro cuadrado y object-cover: la captura llena el hueco
					   recortándose por donde haga falta, nunca deformándose. Así
					   todas las fichas enseñan el mismo cuadrado aunque cada
					   proyecto traiga una foto de proporción distinta.

					   El lado se mide sobre el alto de la tarjeta, que es la
					   dimensión corta, para que el cuadrado quepa igual en la
					   ficha ancha del caso principal y en las 4:3 del listado.

					   El filete no es decorativo: la barra de navegación del
					   propio ARCADIA es casi del mismo crema que la tarjeta y,
					   sin él, la imagen se deshilacha por el borde en tema claro. */
					<img
						src={cover}
						alt=""
						loading="lazy"
						decoding="async"
						class="absolute top-1/2 left-1/2 aspect-square h-[70%] -translate-x-1/2 -translate-y-1/2 border border-line object-cover transition-transform duration-[900ms] ease-out-expo group-hover:scale-[1.03]"
					/>
				)}

				<span class="absolute bottom-5 left-5 max-w-[60%] text-sm leading-snug font-medium text-muted transition-colors duration-500 group-hover:text-ink">
					{name}
				</span>
			</div>
		)
	}
</div>

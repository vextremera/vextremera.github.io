---
import SectionHeading from './SectionHeading.astro';
import { getDict } from '../i18n/utils';
import type { Locale } from '../i18n/types';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = getDict(locale).experience;
---

<section id="experience" class="shell py-24 md:py-32">
	<SectionHeading n={t.n} title={t.title} lead={t.lead} />

	<ol class="mt-14 md:mt-20" data-reveal-group>
		{
			t.items.map((job) => (
				<li
					class="group relative grid grid-cols-12 gap-x-6 gap-y-7 border-t border-line py-10 md:py-14"
					data-reveal
				>
					{/* La línea superior se recorre en acento al pasar por encima */}
					<span
						class="absolute top-0 left-0 h-px w-0 bg-accent transition-[width] duration-[900ms] ease-out-expo group-hover:w-full"
						aria-hidden="true"
					/>

					<div class="col-span-12 lg:col-span-3">
						<p class="label text-ink">{job.period}</p>
						<p class="label mt-2.5 text-faint">{job.location}</p>

						{job.international && (
							<p class="label mt-4 inline-block border border-accent px-2 py-1 text-accent">
								{t.labels.abroad}
							</p>
						)}
						{job.placeholder && (
							<p class="label mt-3 inline-block border border-dashed border-line px-2 py-1 text-faint">
								{getDict(locale).projects.placeholderBadge}
							</p>
						)}
					</div>

					<div class="col-span-12 lg:col-span-5">
						<h3 class="text-h3 font-semibold tracking-tight text-balance">{job.company}</h3>
						<p class="label mt-2 text-accent">{job.role}</p>

						<p class="mt-5 max-w-[52ch] text-muted text-pretty">{job.summary}</p>

						<h4 class="label mt-8 text-faint">{t.labels.duties}</h4>
						<ul class="mt-3 max-w-[52ch] space-y-2">
							{job.duties.map((duty) => (
								<li class="flex gap-3 text-sm text-muted">
									<span class="mt-2.5 h-px w-3 shrink-0 bg-line" aria-hidden="true" />
									<span class="text-pretty">{duty}</span>
								</li>
							))}
						</ul>
					</div>

					<div class="col-span-12 lg:col-span-3 lg:col-start-10">
						<h4 class="label text-faint">{t.labels.learned}</h4>
						<p class="mt-3 text-sm leading-relaxed text-pretty">{job.learned}</p>

						{/* No todos los trabajos traen tecnología detrás. Sin esto, el
						    puesto de sala enseñaba el título con la lista vacía. */}
						{job.stack.length > 0 && (
							<>
								<h4 class="label mt-8 text-faint">{t.labels.stack}</h4>
								<ul class="mt-3 flex flex-wrap gap-1.5">
									{job.stack.map((tech) => (
										<li class="label border border-line px-2 py-1 text-muted">{tech}</li>
									))}
								</ul>
							</>
						)}
					</div>
				</li>
			))
		}
	</ol>
</section>

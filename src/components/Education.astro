---
import SectionHeading from './SectionHeading.astro';
import { getDict } from '../i18n/utils';
import type { Locale } from '../i18n/types';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = getDict(locale).education;
const badge = getDict(locale).projects.placeholderBadge;
---

<section id="education" class="shell py-24 md:py-32">
	<SectionHeading n={t.n} title={t.title} lead={t.lead} />

	<ul class="mt-14 grid grid-cols-12 gap-x-6 gap-y-10 md:mt-20" data-reveal-group>
		{
			t.items.map((study) => (
				<li
					class="group relative col-span-12 border-t border-line pt-6 md:col-span-6"
					data-reveal
				>
					<span
						class="absolute top-0 left-0 h-px w-0 bg-accent transition-[width] duration-[900ms] ease-out-expo group-hover:w-full"
						aria-hidden="true"
					/>

					<div class="flex items-baseline justify-between gap-4">
						<p class="label text-faint">{study.period}</p>
						<p class="label text-faint">{study.location}</p>
					</div>

					{/* La categoría, en recuadro, para que se lea como clasificación
					    y no como parte del nombre del título. */}
					<p class="label mt-5 inline-block border border-line px-2 py-1 text-accent transition-colors duration-500 group-hover:border-accent">
						{study.level}
					</p>

					{/* El titular es solo la materia: es lo que alguien busca al
					    recorrer la lista con la vista. */}
					<h3 class="mt-4 text-h3 font-semibold tracking-tight text-balance">{study.title}</h3>

					<p class="label mt-2.5 text-faint">{study.school}</p>

					<p class="mt-4 max-w-[48ch] text-sm leading-relaxed text-muted text-pretty">
						{study.detail}
					</p>

					<h4 class="label mt-7 text-faint">{t.labels.topics}</h4>
					<ul class="mt-3 flex flex-wrap gap-1.5">
						{study.topics.map((topic) => (
							<li class="label border border-line px-2 py-1 text-muted">{topic}</li>
						))}
					</ul>

					{study.placeholder && (
						<p class="label mt-5 inline-block border border-dashed border-line px-2 py-1 text-faint">
							{badge}
						</p>
					)}
				</li>
			))
		}
	</ul>

	<p class="mt-14 max-w-[52ch] border-t border-line pt-5 text-sm text-faint text-pretty" data-reveal>
		{t.moreNote}
	</p>
</section>

---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { getDict, otherLocale } from '../i18n/utils';
import type { Locale } from '../i18n/types';

interface Props {
	locale: Locale;
	/** Ruta equivalente en el otro idioma (para hreflang y el selector). */
	altPath: string;
	title?: string;
	description?: string;
	/** Las páginas de caso no muestran el índice de secciones. */
	sectionNav?: boolean;
}

const { locale, altPath, title, description, sectionNav = true } = Astro.props;

const t = getDict(locale);
const other = otherLocale(locale);

const pageTitle = title ?? t.meta.title;
const pageDesc = description ?? t.meta.description;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const esUrl = new URL(locale === 'es' ? Astro.url.pathname : altPath, Astro.site).href;
const enUrl = new URL(locale === 'en' ? Astro.url.pathname : altPath, Astro.site).href;

// TODO: exportar public/og.svg a public/og.png (1200×630) — es el único
// recurso gráfico que falta por generar.
const ogImage = new URL('/og.png', Astro.site).href;

// Solo enlazamos perfiles reales: los placeholders no entran en los datos
// estructurados.
const sameAs = t.contact.social.map((s) => s.href).filter((href) => !href.includes('['));

const personSchema = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: 'Victor Extremera',
	jobTitle: locale === 'es' ? 'Desarrollador web full-stack' : 'Full-stack Web Developer',
	description: pageDesc,
	email: `mailto:${t.contact.email}`,
	url: canonical,
	knowsLanguage: ['es', 'en'],
	knowsAbout: [
		'HTML',
		'CSS',
		'JavaScript',
		'TypeScript',
		'Astro',
		'Tailwind CSS',
		'Java',
		'Node.js',
		'MySQL',
		'Accessibility',
	],
	...(sameAs.length ? { sameAs } : {}),
};
---

<!doctype html>
<html lang={t.htmlLang} data-theme="light">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />

		<title>{pageTitle}</title>
		<meta name="description" content={pageDesc} />
		<link rel="canonical" href={canonical} />
		<meta name="generator" content={Astro.generator} />

		<link rel="alternate" hreflang="es" href={esUrl} />
		<link rel="alternate" hreflang="en" href={enUrl} />
		<link rel="alternate" hreflang="x-default" href={esUrl} />

		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<meta name="theme-color" content="#f5f3ef" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#0d0c0a" media="(prefers-color-scheme: dark)" />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Victor Extremera" />
		<meta property="og:locale" content={locale === 'es' ? 'es_ES' : 'en_US'} />
		<meta property="og:locale:alternate" content={other === 'es' ? 'es_ES' : 'en_US'} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={pageDesc} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={t.meta.ogAlt} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={pageDesc} />
		<meta name="twitter:image" content={ogImage} />

		<link
			rel="preload"
			href="/fonts/inter-latin-wght-normal.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link
			rel="preload"
			href="/fonts/instrument-serif-latin-400-italic.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>

		<script
			type="application/ld+json"
			is:inline
			set:html={JSON.stringify(personSchema)}
		/>

		{/* Tema antes del primer pintado: sin parpadeo al cargar. */}
		<script is:inline>
			(function () {
				var root = document.documentElement;
				root.classList.add('js');
				var stored = null;
				try {
					stored = localStorage.getItem('theme');
				} catch (e) {
					/* almacenamiento bloqueado: seguimos con el sistema */
				}
				if (stored === 'dark' || stored === 'light') {
					root.dataset.theme = stored;
				} else {
					root.dataset.theme = window.matchMedia('(prefers-color-scheme: dark)').matches
						? 'dark'
						: 'light';
				}
			})();
		</script>
	</head>

	<body class="min-h-dvh antialiased">
		<a
			href="#main"
			class="label sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:bg-accent focus:px-4 focus:py-3 focus:text-on-accent"
		>
			{t.a11y.skip}
		</a>

		<Nav locale={locale} altPath={altPath} sectionNav={sectionNav} />

		<main id="main">
			<slot />
		</main>

		<Footer locale={locale} />

		<script>
			// ---------------------------------------------------------------
			// Entradas al hacer scroll. ~20 líneas en lugar de una librería:
			// IntersectionObserver, una sola pasada, se desconecta al entrar.
			// ---------------------------------------------------------------
			const reveals = document.querySelectorAll<HTMLElement>('[data-reveal]');

			if (reveals.length) {
				const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

				if (reduce) {
					reveals.forEach((el) => el.classList.add('is-visible'));
				} else {
					const io = new IntersectionObserver(
						(entries) => {
							entries.forEach((entry) => {
								if (!entry.isIntersecting) return;
								const el = entry.target as HTMLElement;
								const group = el.closest<HTMLElement>('[data-reveal-group]');
								if (group) {
									// Escalona los hijos de un mismo grupo.
									const siblings = Array.from(
										group.querySelectorAll<HTMLElement>('[data-reveal]')
									);
									const i = siblings.indexOf(el);
									el.style.setProperty('--reveal-delay', `${Math.min(i, 8) * 70}ms`);
								}
								el.classList.add('is-visible');
								io.unobserve(el);
							});
						},
						{ rootMargin: '0px 0px -12% 0px', threshold: 0.08 }
					);

					reveals.forEach((el) => io.observe(el));
				}
			}

			// ---------------------------------------------------------------
			// Botones magnéticos: el elemento se acerca ligeramente al cursor.
			// Solo con puntero fino y sin reducción de movimiento; solo
			// transform, así que no provoca recálculo de layout.
			// ---------------------------------------------------------------
			const magnets = document.querySelectorAll<HTMLElement>('[data-magnetic]');
			const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
			const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

			if (magnets.length && fine && !calm) {
				const STRENGTH = 0.22;
				const MAX = 7;

				magnets.forEach((el) => {
					let frame = 0;

					el.style.transition = 'transform .6s cubic-bezier(0.16, 1, 0.3, 1)';

					el.addEventListener('pointermove', (e) => {
						if (frame) return;
						frame = requestAnimationFrame(() => {
							const r = el.getBoundingClientRect();
							const dx = e.clientX - (r.left + r.width / 2);
							const dy = e.clientY - (r.top + r.height / 2);
							const x = Math.max(-MAX, Math.min(MAX, dx * STRENGTH));
							const y = Math.max(-MAX, Math.min(MAX, dy * STRENGTH));
							el.style.transform = `translate3d(${x}px, ${y}px, 0)`;
							frame = 0;
						});
					});

					el.addEventListener('pointerleave', () => {
						el.style.transform = '';
					});
				});
			}
		</script>
	</body>
</html>
